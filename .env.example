# RunPulse Apple Watch Edition — Configurazione opzionale
# Se lasci vuoto, la configurazione viene gestita direttamente dall'interfaccia web (Impostazioni)

RUNPULSE_PORT=8000
RUNPULSE_SECRET_SALT=cambiami_con_una_stringa_segreta_casuale

# Password / PIN facoltativo per proteggere l'app
# RUNPULSE_ACCESS_PASSWORD=123456

# URL pubblico se pubblichi su Render / VPS
# RUNPULSE_BASE_URL=https://tua-app.onrender.com

# Database PostgreSQL facoltativo (es. Neon.tech gratuito)
# DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Pre-configurazione opzionale per l'amico (così trova tutto già funzionante!)
# GEMINI_API_KEY=AIzaSy...
# STRAVA_CLIENT_ID=123456
# STRAVA_CLIENT_SECRET=abcdef...
