# RunPulse (Garmin + Whoop Edition) — Configurazione facoltativa
# Se lasci vuoto, configuri tutto comodamente da Impostazioni

RUNPULSE_PORT=8000
RUNPULSE_SECRET_SALT=cambiami_con_una_stringa_segreta_casuale

# PIN facoltativo per proteggere l'app online
# RUNPULSE_ACCESS_PASSWORD=1234

# URL pubblico su Render / VPS
# RUNPULSE_BASE_URL=https://tua-app.onrender.com

# Database PostgreSQL per hosting 24/7 (es. Neon.tech gratuito)
# DATABASE_URL=postgresql://user:password@ep-...neon.tech/neondb?sslmode=require

# Pre-configurazioni per gli amici (così trovano tutto già funzionante!)
# GEMINI_API_KEY=AIzaSy...
# STRAVA_CLIENT_ID=298398
# STRAVA_CLIENT_SECRET=fad5d4cc0dfb53e143f7ae1c2df1d0df854d0677
# WHOOP_CLIENT_ID=...
# WHOOP_CLIENT_SECRET=...
